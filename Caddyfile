{
	admin off
	auto_https off
}

:{$PORT:8080} {
	# Railway's healthcheck has no credentials, so it cannot be pointed at a
	# ReMe route — every one of those is either a job endpoint or the Studio
	# SPA, and exposing any of them unauthenticated would defeat the proxy.
	# Caddy answers this path itself. ReMe's own liveness is guaranteed by the
	# entrypoint instead: if it exits, the container exits and Railway restarts.
	handle /healthz {
		respond "ok" 200
	}

	handle {
		basic_auth {
			{$REME_USERNAME} {$REME_PASSWORD_HASH}
		}

		# flush_interval -1 turns off response buffering, which the streamable
		# HTTP MCP endpoint at /mcp and ReMe's SSE job responses both need.
		reverse_proxy 127.0.0.1:{$REME_INTERNAL_PORT:2333} {
			flush_interval -1
		}
	}

	log {
		output stdout
		format console
	}
}
